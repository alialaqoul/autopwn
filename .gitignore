# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Local operator config & engagement data — never commit these
config.yaml
scope.yaml
logs/
*.log

# VPN profiles & credentials — never commit these
*.ovpn
*.openvpn

# Tool output / loot
*.pot
spns.txt
*.hashcat
loot/
loot_*
users.txt
*.kerb
asrep*.txt
kerb*.txt
# Exported reports at repo root (real reports go to logs/, already ignored)
/session-*.html
/session-*.md

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Sample/exported reports at repo root (real reports go to logs/, already ignored)
/*.docx
/*.pdf
.claude/

# In-place edit/port backups
*.portbak*
.port-bak.*/

# Vendored external exploit PoCs — the readable plaintext is NEVER pushed (unlicensed
# weaponized code). Only the AES-256 ext/*.py.gpg blob is committed; decrypt it with
# autopwn/tools/ext/vendor-crypt.sh + your out-of-repo key. See ext/README.md.
autopwn/tools/ext/*.py
!autopwn/tools/ext/*.py.gpg
